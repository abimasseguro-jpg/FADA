{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fada.local/schemas/v1/resource_telemetry.json",
  "title": "FADA resource telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "machine_id",
    "observed_at",
    "level_id",
    "active_workers",
    "effective_core_clock_hz",
    "throughput_tasks_per_second",
    "temperature_celsius",
    "memory_available_bytes",
    "swap_used_bytes",
    "error_rate",
    "stable",
    "thermal_throttled"
  ],
  "properties": {
    "schema_version": {"const": "fada-resource-telemetry/v1"},
    "observation_id": {"type": "string", "minLength": 1},
    "machine_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "number", "minimum": 0},
    "level_id": {"type": "string", "minLength": 1},
    "active_workers": {"type": "integer", "minimum": 1},
    "effective_core_clock_hz": {"type": "integer", "minimum": 1},
    "throughput_tasks_per_second": {"type": "number", "minimum": 0},
    "temperature_celsius": {"type": "number"},
    "memory_available_bytes": {"type": "integer", "minimum": 0},
    "swap_used_bytes": {"type": "integer", "minimum": 0},
    "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "stable": {"type": "boolean"},
    "thermal_throttled": {"type": "boolean"}
  }
}
