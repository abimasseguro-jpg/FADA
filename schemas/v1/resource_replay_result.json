{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fada.local/schemas/v1/resource_replay_result.json",
  "title": "FADA-RC synthetic replay result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "controller_version",
    "protocol",
    "protocol_sha256",
    "generator",
    "generator_sha256",
    "source_sha256",
    "seeds",
    "samples_per_level",
    "scenarios",
    "decision_cost_ms",
    "discriminants",
    "criteria",
    "passed",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "fada-rc-synthetic-result/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "controller_version": {"const": "fada-rc/0.1"},
    "protocol": {"type": "string", "minLength": 1},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator": {"type": "string", "minLength": 1},
    "generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha256": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "seeds": {"type": "object"},
    "samples_per_level": {"type": "integer", "minimum": 2},
    "scenarios": {"type": "object", "minProperties": 5},
    "decision_cost_ms": {"type": "object"},
    "discriminants": {"type": "object"},
    "criteria": {"type": "object", "minProperties": 8},
    "passed": {"type": "boolean"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
